{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": [
    "scripts/test-server/**/*.ts",
    "scripts/generate-design-assets.ts",
    "backend/src/contracts/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}
